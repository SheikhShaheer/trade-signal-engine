# Postgres. Host port 5433 is used so this does not collide with a local Postgres on 5432.
DATABASE_URL=postgres://tse:tse@localhost:5433/tse

# Market data. Binance public REST needs no key; only the base URL is configurable
# so you can point at a regional mirror or a local recording proxy.
BINANCE_BASE_URL=https://api.binance.com

# News provider: "stub" (deterministic, offline) or "cryptopanic"
NEWS_PROVIDER=stub
# Only read when NEWS_PROVIDER=cryptopanic
CRYPTOPANIC_API_KEY=

# API server consumed by the dashboard
API_PORT=4000
API_HOST=127.0.0.1

# Dashboard -> API base URL
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Reviewer identity stamped onto legacy watchlist audit entries
REVIEWER_NAME=local-operator

# Binance Spot Testnet (optional — required when EXECUTION_MODE=testnet)
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# paper | testnet (live not supported yet)
EXECUTION_MODE=paper

# Kill switch: set true to pause new paper entries (position monitor still runs)
EXECUTION_PAUSED=false

# info | debug | warn | error
LOG_LEVEL=info
